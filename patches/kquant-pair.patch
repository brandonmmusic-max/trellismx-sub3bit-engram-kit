+def _pair_temp_buffers(device: torch.device, tiles: int):
+    batch = max(256, tiles)
+    costs = torch.empty((batch, 2, 65536), dtype=torch.float32, device=device)
+    traceback = torch.empty((batch, 128, 65536), dtype=torch.uint8, device=device)
+    return costs, traceback
+
+
+def quantize_pair_tiles(
+    tiles: torch.Tensor,
+    codebook: torch.Tensor,
+    *,
+    tailbite_context: int,
+) -> tuple[torch.Tensor, torch.Tensor]:
+    """Search 2.5-bit tiles and return values and 5-bit branch symbols."""
+    if tiles.ndim != 2 or tiles.shape[1] != 256 or tiles.dtype != torch.float32:
+        raise ValueError("pair tiles must be FP32 with shape [N, 256]")
+    if tiles.device.type != "cuda":
+        raise ValueError("pair tiles must be CUDA tensors")
+    if codebook.dtype != torch.uint8 or codebook.numel() != 65536:
+        raise ValueError("pair codebook must contain 65,536 uint8 labels")
+    if codebook.device != tiles.device:
+        raise ValueError("pair codebook and tiles must use the same CUDA device")
+    tiles = tiles.contiguous()
+    output = torch.empty_like(tiles)
+    symbols = torch.empty((tiles.shape[0], 128), dtype=torch.int16, device=tiles.device)
+    costs, traceback = _pair_temp_buffers(tiles.device, tiles.shape[0])
+    _extension().quantize_tiles_pair(
+        tiles,
+        output,
+        symbols,
+        costs,
+        traceback,
+        codebook,
+        int(tailbite_context),
+    )
+    if bool((symbols & ~31).any()):
+        raise RuntimeError("pair trellis failed its closed-state check")
+    return output, symbols
