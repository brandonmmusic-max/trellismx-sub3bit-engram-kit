+    max_tile_u32: cutlass.Constexpr[int],
+    task_tile_u32: Int32,
+    tidx: Int32,
+    tcnt: cutlass.Constexpr,
+    k16_rows: cutlass.Constexpr = 8,
+):
+    """Stage any rate into the per-expert B staging layout.
+
+    Shared memory uses a fixed row stride of ``8 * max_tile_u32`` uint32 words
+    per K16 row. Smaller rates populate their leading ``2 * task_tile_u32``
+    16-byte chunks per row and skip the unread suffix; copies past the carrier
+    stream are predicated out.
+    """
+
+    span_chunks = 2 * int(max_tile_u32)
+    valid_chunks = Int32(2) * task_tile_u32
+    transfers = k16_rows * span_chunks
+    limit = Int64(tr_u32.shape[0]) - Int64(4)
+    for i in cutlass.range_constexpr((transfers + tcnt - 1) // tcnt):
+        idx = tidx + Int32(i * tcnt)
+        if idx < Int32(transfers):
+            k16_local = idx // Int32(span_chunks)
+            chunk = idx - k16_local * Int32(span_chunks)
+            if chunk < valid_chunks:
