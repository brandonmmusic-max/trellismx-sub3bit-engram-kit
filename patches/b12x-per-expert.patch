+@cute.jit
+def trellis128_pair_lane_geom(
+    lane: Int32,
+    pair_offset: cutlass.Constexpr[int],
+    pair_count: cutlass.Constexpr[int],
+):
+    """Ring geometry for ``pair_count`` pairs starting at ``pair_offset``.
+
+    A ``p25`` tile is a 640-bit ring of 20 uint32 words. Lane ``l`` owns
+    symbols ``4*l + pair_offset .. + pair_count - 1``. Its four 16-bit windows
+    span 31 bits, so the returned word indices and funnel shift always cover
+    the complete span, including lanes whose span wraps the ring.
+    """
+
+    if cutlass.const_expr(int(pair_count) < 1):
+        raise ValueError("a pair lane span needs at least one pair")
+    ring_u32 = Int32(20)
+    b1 = (Int32(4) * lane + Int32(pair_offset) + Int32(129)) * Int32(5)
+    b0 = b1 - Int32(16)
+    b2 = b1 + Int32((int(pair_count) - 1) * 5)
+    i0 = b0 >> Int32(5)
+    i2 = (b2 - Int32(1)) >> Int32(5)
+    ia = i0 - ring_u32 * (i0 >= ring_u32).to(Int32)
+    ib = i2 - ring_u32 * (i2 >= ring_u32).to(Int32)
+    s2 = (i2 + Int32(1)) * Int32(32) - b2
+    return ia, ib, s2
