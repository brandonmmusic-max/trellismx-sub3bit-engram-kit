+@cute.jit
+def _w4a8_stage_trellis_b_tile_rate(
+    tr_u32: cute.Tensor,
+    smem_base: Int32,
+    tile_base: Int64,
+    k16_stride_u32: Int32,
+    symbol_bits: cutlass.Constexpr[int],
+    operands_per_symbol: cutlass.Constexpr[int],
+    tidx: Int32,
+    tcnt: cutlass.Constexpr,
+    k16_rows: cutlass.Constexpr = 8,
+):
+    """Stage one K128xN128 trellis B tile for a two-number rate descriptor.
+
+    The staged layout is unchanged: each of the eight N16 window blocks of a
+    K16 row is ``tile_u32`` uint32 words, and rows stay ``k16_stride_u32``
+    apart.
+    """
+
+    tile_u32 = 256 * int(symbol_bits) // (32 * int(operands_per_symbol))
+    span_chunks = 2 * tile_u32
+    transfers = k16_rows * span_chunks
+    limit = Int64(tr_u32.shape[0]) - Int64(4)
+    for i in cutlass.range_constexpr((transfers + tcnt - 1) // tcnt):
+        idx = tidx + Int32(i * tcnt)
+        if idx < Int32(transfers):
+            k16_local = idx // Int32(span_chunks)
+            chunk = idx - k16_local * Int32(span_chunks)
+            src = (
+                tile_base
+                + Int64(k16_local) * Int64(k16_stride_u32)
+                + Int64(chunk * Int32(4))
+            )
+            if src >= Int64(0) and src <= limit:
+                cp_async4_shared_global(
+                    smem_base + (idx << Int32(4)),
+                    get_ptr_as_int64(tr_u32, src),
+                )
+
+
+@cute.jit
+def _w4a8_stage_trellis_b_tile_per_expert(
+    tr_u32: cute.Tensor,
+    smem_base: Int32,
+    tile_base: Int64,
