+"""Standalone device probe for scalar and pair procedural-NPK tile decode."""
+
+from __future__ import annotations
+
+import cuda.bindings.driver as cuda
+import cutlass
+import cutlass.cute as cute
+from cutlass.cutlass_dsl import Int32
+
+from b12x._lib.intrinsics.atomics import st_shared_u32
+from b12x._lib.intrinsics.memory import shared_ptr_to_u32
+from b12x.moe._shared.kernels.npk_state_law import npk_decode_pair, npk_decode_ring3
+from b12x.moe._shared.kernels.trellis_ring import (
+    trellis128_pair_lane_geom,
+    trellis256_lane_geom_bits,
+)
+
+
+class P25TileProbeKernel:
+    """Decode every lane of each staged tile without MMA or scheduler logic."""
+
+    _RATES = {
+        "k2": (2, 1, 16),
+        "p25": (5, 2, 20),
+        "k3": (3, 1, 24),
+        "k4": (4, 1, 32),
+        "k5": (5, 1, 40),
+    }
+
+    def __init__(self, rate: str, max_tiles: int):
+        if rate not in self._RATES:
+            raise ValueError(f"probe rate must be one of {tuple(self._RATES)}")
+        self.rate = rate
+        self.symbol_bits, self.operands_per_symbol, self.ring_u32 = self._RATES[rate]
+        self.max_tiles = int(max_tiles)
+
+    @cute.jit
+    def __call__(
+        self,
+        streams: cute.Tensor,
+        output_words: cute.Tensor,
+        active_tiles: Int32,
+        stream: cuda.CUstream,
+    ):
+        self.kernel(streams, output_words, active_tiles).launch(
+            grid=(self.max_tiles, 1, 1),
+            block=(32, 1, 1),
+            stream=stream,
+        )
+
+    @cute.kernel
+    def kernel(
+        self,
+        streams: cute.Tensor,
+        output_words: cute.Tensor,
+        active_tiles: Int32,
+    ):
+        thread, _, _ = cute.arch.thread_idx()
+        block, _, _ = cute.arch.block_idx()
+        tile = Int32(block)
+        tid = Int32(thread)
+        if tile < active_tiles:
+            smem = cutlass.utils.SmemAllocator()
+
+            @cute.struct
+            class Storage:
+                words: cute.struct.Align[cute.struct.MemRange[cutlass.Uint32, 40], 16]
+
+            storage = smem.allocate(Storage)
+            smem_base = shared_ptr_to_u32(storage.words.data_ptr())
+            for step in cutlass.range_constexpr((self.ring_u32 + 31) // 32):
+                word = tid + Int32(step * 32)
+                if word < Int32(self.ring_u32):
+                    st_shared_u32(smem_base + (word << Int32(2)), streams[tile, word])
+            cute.arch.sync_threads()
+            lane = tid
+            if cutlass.const_expr(self.operands_per_symbol == 2):
+                ia, ib, shift = trellis128_pair_lane_geom(lane, 0, 4)
+                low, high = npk_decode_pair(smem_base, Int32(0), ia, ib, shift)
+            else:
+                ia, ib, shift, _ = trellis256_lane_geom_bits(
+                    lane, 0, 8, self.symbol_bits
+                )
+                low, high = npk_decode_ring3(
+                    smem_base, Int32(0), ia, ib, shift, self.symbol_bits
+                )
+            output_words[tile, lane, 0] = low
+            output_words[tile, lane, 1] = high
