+PAIR_MIX_INCREMENT = 1013904223
+
+
+def normalize_rate_set(value) -> tuple[str, ...]:
+    """Validate and canonically order a P8 rate set."""
+
+    if isinstance(value, str):
+        names = value.split(",")
+    elif isinstance(value, (tuple, list)):
+        names = tuple(value)
+    else:
+        raise TypeError(f"a P8 rate set must be a string or sequence; got {value!r}")
+    if not names:
+        raise ValueError("a P8 rate set cannot be empty")
+    for name in names:
+        if not isinstance(name, str) or name not in RATE_CODE:
+            raise ValueError(
+                f"a P8 rate must be one of {list(RATE_CODE)}; got {name!r}"
+            )
+    rate_set = tuple(sorted(set(names), key=RATE_CODE.get))
+    if len(rate_set) != len(names):
+        raise ValueError(f"a P8 rate set cannot repeat a rate; got {value!r}")
+    return rate_set
+
+
+def rate_set_bits(rate_set: tuple[str, ...]) -> int | None:
+    """The scalar bit width of a one-member scalar rate set, else ``None``."""
+
+    if rate_set == ("k2",):
+        return 2
+    if rate_set == ("k3",):
+        return 3
+    if rate_set == ("k4",):
+        return 4
+    if rate_set == ("k5",):
+        return 5
+    return None
+
+
+def max_tile_u32(rate_set: tuple[str, ...]) -> int:
+    """The staging tile width every member of a rate set fits."""
+
+    return max(RATE_TILE_U32[name] for name in rate_set)
+
+
+__all__ = [
+    "PAIR_MIX_INCREMENT",
+    "PAIR_MIX_MULTIPLIER",
+    "PER_EXPERT_SCHEMA",
+    "RATE_CODE",
+    "RATE_NAME",
+    "RATE_TILE_U32",
+    "max_tile_u32",
+    "normalize_rate_set",
+    "rate_set_bits",
+]
