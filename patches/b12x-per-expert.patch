+@dsl_user_op
+def packed_decode_npk_pair_to_e4m3x8(win, *, loc=None, ip=None):
+    """Decode one 31-bit pair-rate window to two packed E4M3x4 words.
+
+    ``win`` ends at the lane's final state. Its four states are five bits
+    apart. Each state and its fixed bijective mix produce one consecutive
+    operand pair.
+    """
+
+    multiplier = f"{_TRELLIS_MCG:#010x}"
+    mask = f"{_TRELLIS_MASK:#010x}"
+    or_operand = f"{_TRELLIS_OR:#010x}"
+    asm = f"""
+        {{
+            .reg .b32 w0,w1,w2,w3,w4,w5,w6,w7, lo, hi, M, A, C;
+            .reg .b32 h01,h23,h45,h67;
+            .reg .b32 s0,s1,s2,s3;
+            .reg .b16 e01,e23,e45,e67;
+            mov.b32 M, {multiplier};
+            mov.b32 A, {_PAIR_MIX_MULTIPLIER};
+            mov.b32 C, {_PAIR_MIX_OFFSET};
+            and.b32 s3, $2, 0xffff;
+            shr.u32 s2, $2, 5; and.b32 s2, s2, 0xffff;
+            shr.u32 s1, $2, 10; and.b32 s1, s1, 0xffff;
+            shr.u32 s0, $2, 15; and.b32 s0, s0, 0xffff;
+            mov.b32 w0, s0;
+            mul.lo.u32 w1, s0, A; add.u32 w1, w1, C; and.b32 w1, w1, 0xffff;
+            mov.b32 w2, s1;
+            mul.lo.u32 w3, s1, A; add.u32 w3, w3, C; and.b32 w3, w3, 0xffff;
+            mov.b32 w4, s2;
+            mul.lo.u32 w5, s2, A; add.u32 w5, w5, C; and.b32 w5, w5, 0xffff;
+            mov.b32 w6, s3;
