+@dataclass(frozen=True)
+class TrellisRateDescriptor:
+    """A trellis rate as symbol bits and operands emitted per symbol."""
+
+    symbol_bits: int
+    operands_per_symbol: int
+
+    @classmethod
+    def scalar(cls, bits: int) -> "TrellisRateDescriptor":
+        bits = int(bits)
