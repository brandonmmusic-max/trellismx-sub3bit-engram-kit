+def expected_per_expert_tensor_shapes(rate_counts: tuple[int, int, int], local_intermediate_size: int,
+                                      *, scale_storage: str = "plain") -> dict[str, tuple[int, ...]]:
+    """One rank's per-expert tensors, with absent banks omitted."""
+    if len(rate_counts) != len(RATE_SET) or sum(rate_counts) != NUM_EXPERTS:
+        raise ValueError(f"per-expert rate counts {rate_counts!r} must sum to {NUM_EXPERTS}")
+    if scale_storage not in ("plain", "csf"):
+        raise ValueError(f"scale storage must be 'plain' or 'csf', got {scale_storage!r}")
+    if (type(local_intermediate_size) is not int or local_intermediate_size <= 0
+            or local_intermediate_size % SLOT_CHANNELS or GLOBAL_INTERMEDIATE % local_intermediate_size):
+        raise ValueError(f"trellismx local intermediate size must divide {GLOBAL_INTERMEDIATE} into"
+                         f" {SLOT_CHANNELS}-channel slots, got {local_intermediate_size!r}")
+    row_groups = 2 * local_intermediate_size // SLOT_CHANNELS
+    hidden_tiles = HIDDEN_SIZE // 16
+    shapes = {
+        "expert_rate_u8": (NUM_EXPERTS,),
+        "expert_slot_u16": (NUM_EXPERTS,),
+    }
+    for rate, count, words in zip(RATE_SET, rate_counts, (32, 40, 48), strict=True):
+        if count:
+            shapes[f"w13_trellis_{rate}"] = (2, count, hidden_tiles, row_groups, words)
+            shapes[f"w2_trellis_{rate}"] = (count, row_groups, hidden_tiles, words)
+    common = {
+        "intermediate_scales_fp16": (NUM_EXPERTS, 3 * local_intermediate_size),
+        "coupled_sign_draw_u8": (NUM_EXPERTS,),
+        "gate_up_suh_fp16": (HIDDEN_SIZE,),
+        "down_svh_fp16": (HIDDEN_SIZE,),
+    }
+    if scale_storage == "plain":
+        common["w13_scale_ue8m0"] = (NUM_EXPERTS, 2 * local_intermediate_size, HIDDEN_SIZE // 32)
+        common["w2_scale_ue8m0"] = (NUM_EXPERTS, HIDDEN_SIZE, local_intermediate_size // 32)
+    else:
+        common["w13_scale_csf_plane"] = (
+            NUM_EXPERTS, 2 * local_intermediate_size // 16, 16 * (1 + (HIDDEN_SIZE // 32 + 7) // 8))
+        common["w13_scale_csf_exceptions"] = (None,)
+        common["w13_scale_csf_offsets"] = (NUM_EXPERTS + 1,)
+        common["w2_scale_csf_plane"] = (
