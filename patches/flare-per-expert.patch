+def _declared_rate_bytes(path: Path) -> tuple[int, ...]:
+    """Read only ``expert_rate_u8`` from a sidecar header's declared geometry."""
+    import numpy
+
+    try:
+        with path.open("rb", buffering=0) as source:
+            size = os.fstat(source.fileno()).st_size
+            length = _header_length(source.read(8), size, path)
+            raw = source.read(length)
+    except OSError as error:
+        raise ValueError(f"sidecar {path} is unreadable: {error}") from error
+    metadata, entries = _header_entries(
+        raw, size, path)
+    if "expert_rate_u8" not in entries:
+        raise ValueError(f"sidecar {path} has no expert_rate_u8")
+    dtype, shape, offset = entries["expert_rate_u8"]
+    if dtype != "U8" or shape != (NUM_EXPERTS,):
+        raise ValueError(f"sidecar {path}: expert_rate_u8 must be U8 {(NUM_EXPERTS,)}")
+    with path.open("rb", buffering=0) as source:
+        source.seek(offset)
+        raw = source.read(NUM_EXPERTS)
+    if len(raw) != NUM_EXPERTS:
+        raise ValueError(f"sidecar {path}: truncated expert_rate_u8")
+    return tuple(int(value) for value in numpy.frombuffer(raw, dtype=numpy.uint8))
 
 
