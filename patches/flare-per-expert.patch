+def _rate_assignment(manifest: dict, root: Path, allocation: dict[int, tuple[int, int, int]]) -> tuple[str, dict]:
+    """Validate ``design/rate-assignment.json`` against the manifest and allocation."""
+    declared = manifest.get("rate_assignment")
+    if not isinstance(declared, dict):
+        raise _gate(2, "rate_assignment must be an object")
+    path_name, digest = declared.get("path"), declared.get("sha256")
+    if path_name != "design/rate-assignment.json" or not _sha256_field(digest):
+        raise _gate(2, "rate_assignment must name design/rate-assignment.json and a 64-digit SHA-256")
+    if declared.get("rule") not in ("route-mass", "shapley"):
+        raise _gate(2, f"rate_assignment rule must be route-mass or shapley, got {declared.get('rule')!r}")
+    for name in ("budget_bits", "achieved_bits"):
+        value = declared.get(name)
+        if type(value) not in (int, float) or value <= 0:
+            raise _gate(2, f"rate_assignment {name} must be positive, got {value!r}")
+    path = root / path_name
+    document = _json_object(path, "rate assignment")
+    if document.get("schema") != "trellismx.rate-assignment.v1":
+        raise _gate(2, f"rate assignment schema is {document.get('schema')!r},"
+                       " expected 'trellismx.rate-assignment.v1'")
+    if document.get("rule") != declared.get("rule") or document.get("budget_bits") != declared.get("budget_bits"):
+        raise _gate(2, "rate assignment rule or budget differs from the manifest's rate_assignment")
+    if not isinstance(document.get("source"), dict):
+        raise _gate(2, "rate assignment source must be an object")
+    layers = document.get("layers")
+    if not isinstance(layers, dict) or set(layers) != {str(layer) for layer in allocation}:
+        raise _gate(2, "rate assignment layers differ from the release allocation")
+    for layer, rates in layers.items():
+        if (not isinstance(rates, list) or len(rates) != NUM_EXPERTS
+                or any(rate not in RATE_CODES for rate in rates)):
+            raise _gate(2, f"rate assignment layer {layer} must name a known rate for each of {NUM_EXPERTS} experts")
+        counts = tuple(rates.count(rate) for rate in RATE_SET)
+        if counts != allocation[int(layer)]:
+            raise _gate(2, f"rate assignment layer {layer} counts {dict(zip(RATE_SET, counts))} differ from"
+                           f" the manifest allocation {dict(zip(RATE_SET, allocation[int(layer)]))}")
+    actual = _canonical_sha256(document)
+    if actual != digest:
+        raise _gate(2, f"rate assignment canonical SHA-256 is {actual}, manifest declares {digest}")
+    return actual, document
