+def _rate_counts(value) -> tuple[int, int, int] | None:
+    if not isinstance(value, dict):
+        return None
+    counts = tuple(value.get(rate) for rate in RATE_SET)
+    if any(type(count) is not int or count < 0 for count in counts) or sum(counts) != NUM_EXPERTS:
+        return None
+    return counts
